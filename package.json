{
  "name": "frontdesk-remake",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "db:generate": "npm --prefix backend run db:generate",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "test": "npm --prefix backend test"
  }
}
