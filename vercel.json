{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --prefix backend && npm ci --include=dev --prefix frontend",
  "buildCommand": "npm run db:generate && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "backend/node_modules/.prisma/client/libquery_engine-rhel-openssl-3.0.x.so.node"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" }
  ],
  "crons": [
    { "path": "/api/jobs/auto-close", "schedule": "0 13 * * *" }
  ]
}
